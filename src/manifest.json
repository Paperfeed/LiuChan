{
  "{{chrome}}.manifest_version": 3,
  "{{firefox}}.manifest_version": 2,
  "icons": {
    "16": "icon/16.png",
    "48": "icon/48.png",
    "128": "icon/128.png"
  },
  "{{chrome}}.action": {
    "default_title": "LiuChan Chinese Dictionary"
  },
  "{{firefox}}.browser_action": {
    "default_title": "LiuChan Chinese Dictionary"
  },
  "options_ui": {
    "page": "src/options/index.html",
    "open_in_tab": true,
    "{{firefox}}.chrome_style": false
  },
  "permissions": [
    "activeTab",
    "storage",
    "contextMenus",
    "notifications",
    "tts"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content.tsx"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "{{chrome}}.service_worker": "src/background.ts",
    "{{firefox}}.scripts": ["src/background.ts"]
  }
}
