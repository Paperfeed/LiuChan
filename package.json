{
  "name": "liuchan",
  "private": true,
  "packageManager": "pnpm@10.11.0",
  "displayName": "LiuChan Chinese Popup Dictionary",
  "version": "3.0.0",
  "description": "Chinese Popup Dictionary",
  "author": "Aldert Vaandering",
  "license": "GPL-3.0",
  "homepage": "https://paperfeed.github.io/LiuChan/",
  "bugs": {
    "url": "https://github.com/Paperfeed/LiuChan/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "submit": "publish-extension",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare",
    "serve:test-page": "npx http-server ./assets",
    "lint": "eslint . --quiet",
    "lint:fix": "eslint ./src --ext .jsx,.js,.ts,.tsx --quiet --fix --ignore-path ./.gitignore && prettier  --loglevel warn --write \"./**/*.{js,jsx,ts,tsx,css,json}\" ",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@davstack/store": "^1.1.5",
    "@floating-ui/react": "^0.26.15",
    "autoprefixer": "^10.4.19",
    "fflate": "^0.8.2",
    "immer": "^10.1.1",
    "postcss": "^8.4.38",
    "react": "^18.2.0",
    "react-color-palette": "^7.1.1",
    "react-dom": "^18.2.0",
    "ts-deepmerge": "^7.0.0",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.3.0",
    "@playwright/test": "^1.62.1",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.3.0",
    "@types/webextension-polyfill": "^0.10.7",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.3.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-import": "2.29.1",
    "eslint-plugin-react": "7.34.1",
    "eslint-plugin-react-hooks": "4.6.2",
    "eslint-plugin-simple-import-sort": "12.1.0",
    "eslint-plugin-sort-destructure-keys": "2.0.0",
    "eslint-plugin-sort-keys-fix": "1.1.2",
    "eslint-plugin-typescript-sort-keys": "3.2.0",
    "prettier": "^2.5.1",
    "publish-browser-extension": "^6.0.0",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.4.5",
    "typescript-eslint": "^7.9.0",
    "vite": "^6.4.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^3.2.7",
    "web-ext": "^9.4.0",
    "webextension-polyfill": "^0.10.0",
    "wxt": "^0.21.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Paperfeed/LiuChan.git"
  },
  "keywords": [
    "liuchan",
    "chinese",
    "dictionary",
    "mouse-over",
    "popup"
  ],
  "prettier": {
    "trailingComma": "es5",
    "semi": false,
    "singleQuote": true
  }
}
